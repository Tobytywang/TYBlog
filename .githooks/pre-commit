#!/bin/sh
# 提交前拦截大文件
#
# 历史不可变：二进制文件一旦进了库，就只能重写历史才能摘掉——那会让所有后代提交
# 换哈希、每个已有副本变成分叉。所以门槛必须卡在「提交」这一刻，不能靠事后补救。
#
# 两种装法，同一份逻辑，不要改出第二个版本：
#   npm run hooks          只对本仓库生效（core.hooksPath = .githooks）
#   npm run hooks:global   对全部仓库生效（复制到 ~/.config/git/hooks 并设全局）
#
# 单个仓库可覆盖，不影响其他仓库：
#   git config --local hooks.bigFiles.limitMb 20       放宽阈值
#   git config --local hooks.bigFiles.enabled false    整个关掉（确认该仓库确实要存大文件）
#
# 为什么用 sh 不用 Node：全局装法会在任意仓库里执行，不能假设有 node。
# 先执行仓库原有的 .git/hooks/pre-commit，避免设置全局 hooksPath 后把它静默废掉。

if [ -x .git/hooks/pre-commit ] && [ ! -L .git/hooks/pre-commit ]; then
  .git/hooks/pre-commit || exit $?
fi

if [ "$(git config --bool hooks.bigFiles.enabled)" = "false" ]; then
  exit 0
fi

LIMIT_MB=$(git config --int hooks.bigFiles.limitMb)
[ -n "$LIMIT_MB" ] || LIMIT_MB=2
LIMIT=$((LIMIT_MB * 1024 * 1024))

REPORT=$(mktemp) || exit 0
trap 'rm -f "$REPORT"' EXIT INT TERM

# quotePath=false 让中文文件名原样输出，否则会被转义成八进制导致取不到大小。
# 用换行分隔而非 -z：/bin/sh 在 Debian 系是 dash，read 不支持 -d。
git -c core.quotePath=false diff --cached --name-only --diff-filter=AM |
while IFS= read -r file; do
  [ -n "$file" ] || continue
  size=$(git cat-file -s ":$file" 2>/dev/null) || continue
  [ "$size" -gt "$LIMIT" ] || continue
  printf '  %6.2f MB  %s\n' "$(awk -v s="$size" 'BEGIN { print s / 1048576 }')" "$file"
done > "$REPORT"

[ -s "$REPORT" ] || exit 0

printf '\n✋ 提交被拦截：以下文件超过 %s MB\n\n' "$LIMIT_MB"
cat "$REPORT"
printf '\n大文件进历史后只能重写历史才能删掉，每个已有副本都会变成分叉。\n'
printf '确实要提交：git commit --no-verify\n'
printf '该仓库确实要存大文件：git config --local hooks.bigFiles.enabled false\n\n'
exit 1
